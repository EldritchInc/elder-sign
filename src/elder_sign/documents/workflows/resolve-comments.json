          "version": "1.0.0",
          "runtime": "process"
        }
      },
      "depends_on": [],
      "inputs": [
        {
          "name": "scan",
          "source": {
            "event_type": "workflow.input.received",
            "field_name": "input"
          }
        }
      ],
      "outputs": [
        {
          "name": "keyed_scan",
          "path": [
            "scan"
          ]
        }
      ],
      "conditions": [],
      "retry_policy": {
        "max_attempts": 1,
        "initial_delay_seconds": 0.0,
        "backoff_multiplier": 1.0,
        "maximum_delay_seconds": null
